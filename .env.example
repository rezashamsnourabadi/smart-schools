# Local development only. Production requires private credentials and HTTPS.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_PORT=3001
DATABASE_URL=postgres://school_app:local-app-password@127.0.0.1:55432/schools
MIGRATION_DATABASE_URL=postgres://school_owner:local-owner-password@127.0.0.1:55432/schools
REDIS_URL=redis://127.0.0.1:56379
SESSION_SECRET=development-only-change-this-secret-before-production
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=school-private
S3_ACCESS_KEY=local-storage
S3_SECRET_KEY=local-storage-password

# Optional provider bridge: POST {to,message,reference}; response {accepted:true,messageId:string}.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
BALE_WEBHOOK_SECRET=
METRICS_TOKEN=

# Generate a separate random key; store it off this host as well.
BACKUP_KEY=
BACKUP_DIR=backups
BACKUP_COMPOSE_FILE=compose.yaml
BACKUP_S3_ENDPOINT=http://127.0.0.1:59000

# First administrator only; provide through environment, then remove.
BOOTSTRAP_USERNAME=
BOOTSTRAP_NAME=
BOOTSTRAP_PHONE=
BOOTSTRAP_PASSWORD=
