{
  "name": "dana-school-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "node --import tsx --watch server/index.ts",
    "start": "node build/server/index.js",
    "worker": "node --import tsx server/worker.ts",
    "db:migrate": "node --import tsx server/migrate.ts",
    "admin:create": "node --import tsx server/cli.ts bootstrap-admin",
    "storage:init": "node --import tsx server/cli.ts storage-init",
    "test:api": "node --import tsx --test --test-concurrency=1 server/tests/*.test.ts",
    "test:legacy": "node --import tsx scripts/check-school-scope.ts && node --import tsx scripts/check-attendance.ts && node --import tsx scripts/check-grades.ts && node --import tsx scripts/check-financial-ledger.ts && node --import tsx scripts/check-academic-year.ts && node --import tsx scripts/check-schedule.ts && node --import tsx scripts/check-storage.ts",
    "lint_applet": "npm run lint",
    "compile_applet": "npm run build",
    "build:server": "node scripts/build-server.mjs",
    "db:seed": "node --import tsx server/seed.ts",
    "test:browser": "playwright test",
    "test:performance": "node --import tsx scripts/check-performance.ts",
    "test:load": "node --import tsx scripts/load-test.ts",
    "backup:create": "node --import tsx infra/backup.ts create",
    "backup:verify": "node --import tsx infra/backup.ts verify"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@fastify/compress": "9.2.2",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "@fastify/swagger": "9.9.2",
    "@fontsource/vazirmatn": "5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "5.105.0",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "0.45.1",
    "bullmq": "6.5.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "0.35.5",
    "vite": "^6.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "10.0.6",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
